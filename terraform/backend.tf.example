# Optional remote state. Copy to backend.tf, create the bucket first, then run
# `terraform init -migrate-state`.
#
# terraform {
#   backend "s3" {
#     bucket       = "staydesk-tfstate-<your-account-id>"
#     key          = "staydesk/eks/terraform.tfstate"
#     region       = "ap-south-1"
#     encrypt      = true
#     use_lockfile = true # S3-native state locking (Terraform >= 1.10)
#   }
# }
